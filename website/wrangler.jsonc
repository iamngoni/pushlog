{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pushlog-site",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "pushlog.iamngoni.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
