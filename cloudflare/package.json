{
  "name": "pushlog-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "dev": "wrangler dev --persist-to .wrangler/state",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply pushlog-staging --local --persist-to .wrangler/state",
    "db:migrate:staging": "wrangler d1 migrations apply pushlog-staging --remote",
    "deploy:staging": "wrangler deploy",
    "migrate:firestore": "tsx scripts/migrate-firestore.ts",
    "reconcile:firestore": "tsx scripts/migrate-firestore.ts --reconcile"
  },
  "dependencies": {
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@cloudflare/workers-types": "5.20260804.1",
    "@types/node": "24.0.15",
    "firebase-admin": "14.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  }
}
